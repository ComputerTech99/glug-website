---
import { LOGO_VIEWBOX, MARK_VIEWBOX, LOGO_SILHOUETTE, LOGO_INK } from '../assets/logo-paths';

interface Props {
  variant?: 'full' | 'mark';
  class?: string;
  animate?: boolean;
  title?: string;
}
const { variant = 'full', class: cls, animate = false, title = 'GLUG FET-JU — Linux Users Group' } = Astro.props;
const viewBox = variant === 'mark' ? MARK_VIEWBOX : LOGO_VIEWBOX;
---
<svg
  class:list={['logo', `logo--${variant}`, { 'logo--animate': animate }, cls]}
  viewBox={viewBox}
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <path class="sil" d={LOGO_SILHOUETTE} fill-rule="evenodd" />
  <path class="ink" d={LOGO_INK} fill-rule="evenodd" pathLength="1" />
</svg>

<style>
  .logo { display: block; width: 100%; height: auto; overflow: hidden; }
  .sil { fill: var(--white); }
  .ink { fill: currentColor; }
  .logo--animate .ink {
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    fill-opacity: 0;
    animation: draw 1.2s cubic-bezier(.6,0,.3,1) 0.2s forwards, fill 0.5s ease 1.1s forwards;
  }
  .logo--animate .sil { opacity: 0; animation: fade 0.4s ease 1.1s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fill { to { fill-opacity: 1; stroke-width: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .logo--animate .ink { stroke-dashoffset: 0; fill-opacity: 1; stroke-width: 0; }
    .logo--animate .sil { opacity: 1; }
  }
</style>
