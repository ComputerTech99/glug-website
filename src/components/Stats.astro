---
interface Props { items: { value: number | string; suffix?: string; label: string }[] }
const { items } = Astro.props;
---
<dl class="stats">
  {items.map((s) => (
    <div>
      <dt class="mono">{s.label}</dt>
      <dd><span data-count={typeof s.value === 'number' ? s.value : undefined}>{s.value}</span>{s.suffix && <i>{s.suffix}</i>}</dd>
    </div>
  ))}
</dl>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('.stats [data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const target = Number(el.dataset.count);
        const start = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - start) / 1200);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); margin: 0; }
  .stats > div { padding: 56px 0; display: flex; flex-direction: column-reverse; }
  dd { margin: 0; font-size: clamp(56px, 8vw, 128px); font-weight: 900; letter-spacing: -0.06em; line-height: 1; font-variant-numeric: tabular-nums; }
  dd i { font-style: normal; color: var(--sig-display); }
  dt { font-size: 12px; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 8px; }
  @media (max-width: 900px) { .stats { grid-template-columns: 1fr 1fr; } .stats > div { padding: 32px 0; } }
</style>
