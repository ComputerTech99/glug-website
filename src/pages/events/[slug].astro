---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { formatEventDate, isUpcoming } from '../../lib/events';
import { buildNow } from '../../lib/now';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

interface Props { event: CollectionEntry<'events'> }
const { event } = Astro.props;
const { title, date, endDate, venue, type, poster, summary, registerUrl, photos } = event.data;
const { Content } = await render(event);
const upcoming = isUpcoming(event, buildNow());
const TYPE_LABEL: Record<string, string> = {
  workshop: 'Workshop', talk: 'Talk', hacknight: 'Hack Night', installfest: 'Install Fest', other: 'Event',
};
const when = endDate ? `${formatEventDate(date)} – ${formatEventDate(endDate)}` : formatEventDate(date);
---
<Base title={title} description={summary} ogImage={poster?.src}>
  <main id="main" class="wrap">
    <p class="back mono"><a href="/events/">← All events</a></p>
    <header class="head">
      <p class="lbl"><i>//</i> {TYPE_LABEL[type]}</p>
      <h1 class="h-display">{title}</h1>
      <dl class="meta mono">
        <div><dt>Date</dt><dd><time datetime={date.toISOString()}>{when}</time></dd></div>
        <div><dt>Venue</dt><dd>{venue}</dd></div>
        <div><dt>Type</dt><dd>{TYPE_LABEL[type]}</dd></div>
      </dl>
      {upcoming && registerUrl && <Button href={registerUrl} external>Register →</Button>}
      {!upcoming && <p class="happened mono">It happened ✦</p>}
    </header>

    <div class="layout">
      <div class="poster-wrap">
        {poster ? (
          <Image src={poster} alt={`${title} poster`} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 520px" class="poster" />
        ) : (
          <div class="poster poster-fallback grid-bg" aria-hidden="true"><span>{title}</span></div>
        )}
      </div>
      <article class="prose"><Content /></article>
    </div>

    {!upcoming && photos && photos.length > 0 && (
      <section class="gallery" aria-labelledby="gallery-h">
        <h2 id="gallery-h" class="lbl"><i>✦</i> Photos</h2>
        <div class="grid">
          {photos.map((p) => <Image src={p.src} alt={p.alt} widths={[480, 960]} sizes="(max-width: 700px) 100vw, 50vw" />)}
        </div>
      </section>
    )}
  </main>
</Base>

<style>
  .back { padding-top: 32px; font-size: 13px; margin: 0; }
  .back a { text-decoration: none; }
  .back a:hover { color: var(--sig); }
  .head { padding-block: clamp(48px, 9vh, 110px) clamp(48px, 7vw, 80px); }
  h1 { font-size: clamp(26px, 7.4vw, 120px); margin: 20px 0 40px; max-width: 16ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 16px 56px; margin: 0 0 40px; font-size: 14px; }
  .meta dt { color: var(--muted); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .meta dd { margin: 4px 0 0; }
  .happened { display: inline-block; background: var(--ink); color: var(--paper); padding: 10px 16px; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; margin: 0; }
  .layout { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; padding-bottom: var(--section-pad); }
  .poster { width: 100%; height: auto; border: 2px solid var(--ink); box-shadow: var(--shadow-lg); background: var(--white); }
  .poster-fallback { aspect-ratio: 4 / 3; display: flex; align-items: flex-end; padding: 24px; background-color: var(--paper); }
  .poster-fallback span { font-weight: 900; text-transform: uppercase; letter-spacing: -0.04em; line-height: 0.9; font-size: clamp(32px, 4vw, 56px); overflow-wrap: anywhere; }
  .prose { font-size: 18px; line-height: 1.65; max-width: 68ch; }
  .prose :global(p:first-child) { margin-top: 0; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; background: var(--white); border: 1px solid var(--line); padding: 1px 6px; }
  .prose :global(a) { text-decoration-color: var(--sig); text-underline-offset: 4px; }
  .gallery { padding-bottom: var(--section-pad); }
  .gallery .lbl { margin: 0 0 32px; }
  .gallery .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .gallery img { width: 100%; height: auto; border: 2px solid var(--ink); box-shadow: var(--shadow-md); }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .gallery .grid { grid-template-columns: 1fr; } }
</style>
