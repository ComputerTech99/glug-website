---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="GLUG FET-JU — GNU/Linux Users Group, Jain University" description="GLUG FET-JU is the GNU/Linux Users Group at the Faculty of Engineering & Technology, Jain University. Workshops, install fests and open source contributions.">
  <main id="main">
    <section class="hero wrap">
      <div class="hero-text">
        <p class="lbl"><i>//</i> GNU/Linux Users Group — FET, Jain University</p>
        <h1 class="h-display">
          <span class="line">Free</span>
          <span class="line">as in</span>
          <span class="line"><em>freedom.</em></span>
        </h1>
      </div>
      <div class="tux-card">
        <Logo variant="full" animate />
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    min-height: calc(100svh - 90px);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 48px;
    padding-block: 12vh 10vh;
  }
  h1 { font-size: clamp(56px, 13vw, 220px); margin: 28px 0 56px; }
  .line { display: block; animation: rise 0.7s cubic-bezier(.2,.7,.2,1) both; }
  .line:nth-child(2) { animation-delay: 80ms; }
  .line:nth-child(3) { animation-delay: 160ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(0.4em); } }
  .tux-card {
    width: 260px;
    background: var(--white);
    border: 2px solid var(--ink);
    box-shadow: var(--shadow-lg);
    padding: 24px;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .tux-card { width: 180px; padding: 16px; }
  }
</style>
